# Copie para .env e preencha. Nenhum provedor está fixo no código.
# Modelos no formato "provedor:modelo", resolvidos por langchain.chat_models.init_chat_model.
# Provedores com extra no pyproject: groq | google_genai | openai | anthropic
#   uv sync --all-extras   (ou --extra groq / --extra google / --extra openai / --extra anthropic)

# Configuração do experimento (Groq)
# fast: adapters, formatters, refiner e baseline
LLM_FAST_MODEL=groq:openai/gpt-oss-20b
# strong: extractor e fallback quando o fast não entrega o schema
LLM_STRONG_MODEL=groq:openai/gpt-oss-120b
# judge: LLM Judge (vazio = strong). Prefira um modelo de outra família, diferente do gerador.
LLM_JUDGE_MODEL=groq:qwen/qwen3.8-27b
# claims: checker de afirmações (vazio = judge). Separar divide o consumo entre cotas.
LLM_CLAIMS_MODEL=groq:openai/gpt-oss-120b

# Alternativa com Gemini (Google AI Studio)
# LLM_FAST_MODEL=google_genai:gemini-3.5-flash-lite
# LLM_STRONG_MODEL=google_genai:gemini-3.8-flash
# LLM_JUDGE_MODEL=google_genai:gemini-3.8-flash
# LLM_CLAIMS_MODEL=google_genai:gemini-3.8-flash

LLM_TEMPERATURE=0.2
# Esforço de raciocínio dos modelos gpt-oss: low | medium | high (vazio = padrão do provedor)
LLM_REASONING_EFFORT=low

# Chaves dos provedores usados
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Reflection loop: tentativas por célula (inclui a 1ª) e ganho mínimo da nota agregada
MAX_RETRIES=3
REFLECTION_EPSILON=0.01
